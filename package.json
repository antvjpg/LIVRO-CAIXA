{
  "name": "livro-caixa-code-qa",
  "version": "0.1.0",
  "private": true,
  "description": "C.O.D.E. — Controle Operacional de Diagnóstico e Execução. Infraestrutura de QA/E2E do LIVRO-CAIXA. Somente desenvolvimento/testes: não é código de produção do aplicativo.",
  "license": "UNLICENSED",
  "scripts": {
    "code:test": "playwright test && node e2e/reports/generate-report.cjs --strict",
    "code:test:headed": "playwright test --headed",
    "code:smoke": "playwright test --project=smoke",
    "code:movimentacoes": "playwright test --project=movimentacoes",
    "code:orcamento": "playwright test --project=orcamento",
    "code:lia": "playwright test --project=lia",
    "code:metas": "playwright test --project=metas",
    "code:investimentos": "playwright test --project=investimentos",
    "code:report": "node e2e/reports/generate-report.cjs",
    "code:oracles": "node --test \"e2e/oracles/*.test.mjs\"",
    "code:reset": "node e2e/seeds/reset.cjs",
    "code:cleanup": "node e2e/seeds/cleanup.cjs",
    "code:list": "node e2e/scripts/list-tests.cjs",
    "code:serve": "python3 -m http.server 8000 --bind 127.0.0.1",
    "code:report:strict": "node e2e/reports/generate-report.cjs --strict",
    "code:security": "node --test \"e2e/security/*.test.mjs\"",
    "code:syntax": "node e2e/scripts/syntax-check.cjs",
    "code:v20": "node --test \"worker/test/v20-01-*.test.mjs\" \"e2e/oracles/v20-01-*.test.mjs\" \"e2e/security/v20-01-*.test.mjs\"",
    "code:v20-02": "node --test \"e2e/oracles/v20-02-*.test.mjs\" \"e2e/security/v20-02-*.test.mjs\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
