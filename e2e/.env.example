# C.O.D.E. — configuração de ambiente (exemplo).
#
# CAMINHO PADRÃO: nada aqui é necessário. Cada execução de "npm run code:test"
# gera uma identidade QA EFÊMERA (code-qa-<run-id>-<sufixo>@livrocaixa.test +
# senha forte) só na memória dos processos da run — sem arquivo de senha, sem
# GitHub Secret. No globalTeardown a conta criada pela run é excluída.
#
# Este arquivo existe apenas para o FALLBACK MANUAL (conta QA declarada). A
# conta declarada é tratada como preexistente e NUNCA é excluída pelo C.O.D.E.
# Copie para e2e/.env.local (gitignored) ou defina como variável de ambiente.
# NUNCA versione o arquivo real com credenciais.

# URL base do aplicativo (servidor local padrão do projeto: python3 -m http.server 8000)
CODE_BASE_URL=http://127.0.0.1:8000

# Fallback manual (opcional) — desativa a identidade efêmera da run:
# CODE_TEST_EMAIL=code-qa-seu-usuario@livrocaixa.test
# CODE_TEST_PASSWORD=sua-senha-qa

# Projeto Firebase (config pública do app) — raramente é preciso alterar
CODE_FIRESTORE_PROJECT=livro-caixa-54357

# "0" desliga a geração da identidade efêmera: sem credencial as suítes ficam
# BLOCKED (visível no relatório) — nunca executam às cegas. Padrão: ligado.
# CODE_TEST_AUTO_PROVISION=0

# Domínios aceitos para conta QA (separados por vírgula). Padrão: livrocaixa.test
CODE_TEST_EMAIL_DOMAINS=livrocaixa.test

# Escape de emergência: "1" libera qualquer e-mail (só use se tiver certeza
# de que aquela conta é de teste — o reset apaga TODO o escopo dela).
# CODE_TEST_ALLOW_ANY_EMAIL=1
